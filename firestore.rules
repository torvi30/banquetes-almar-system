rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si el usuario es administrador autenticado
    function isAdmin() {
      return request.auth != null;
    }

    // Catálogo público: Visitantes pueden ver, solo Admin puede crear/modificar/eliminar
    match /paquetes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mobiliario_alquiler/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventario/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /servicios/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galeria/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /anuncio/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /anuncios/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cotizaciones: Cualquier visitante puede enviar una solicitud (create), solo Admin gestiona
    match /cotizaciones/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Operaciones administrativas confidenciales: Solo Admin autenticado
    match /reservas/{document} {
      allow read, write: if isAdmin();
    }

    match /eventos/{document} {
      allow read, write: if isAdmin();
    }

    match /clientes/{document} {
      allow read, write: if isAdmin();
    }

    match /pagos/{document} {
      allow read, write: if isAdmin();
    }

    match /admins/{document} {
      allow read, write: if isAdmin();
    }
  }
}
