rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si el usuario es administrador autenticado
    function isAdmin() {
      return request.auth != null;
    }

    // Paquetes y catálogo de mobiliario: Público puede leer, solo Admin puede editar
    match /paquetes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mobiliario_alquiler/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galeria/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cotizaciones: Cualquier visitante puede crear una cotización (create), solo Admin puede leer o modificar
    match /cotizaciones/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reservas, Clientes y Pagos: Privados para administración
    match /reservas/{document} {
      allow read, write: if isAdmin();
    }

    match /clientes/{document} {
      allow read, write: if isAdmin();
    }

    match /pagos/{document} {
      allow read, write: if isAdmin();
    }
  }
}
