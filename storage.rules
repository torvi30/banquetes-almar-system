rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotos de galería y catálogo: Públicas para lectura, solo Admin para subir/borrar
    match /galeria/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mobiliario/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comprobantes de pago: Solo admin y subida controlada
    match /comprobantes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
